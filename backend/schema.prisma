datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  model     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  role           String
  content        String
  tokensPerSec   Float?
  latency        Float?
  ram            String?
  score          Float?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model BenchmarkResult {
  id           String   @id @default(cuid())
  prompt       String
  model        String
  tokensPerSec Float
  latency      Float
  ram          String
  score        Float
  createdAt    DateTime @default(now())
}

model Template {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String?
  tags      String[]
  createdAt DateTime @default(now())
}
